{
    "autoload": {
        "psr-4": {
            "PHPFramework\\": "core/",
            "App\\": "app/"
        }
    },
    "require": {
        "php": ">=8.0",
        "symfony/var-dumper": "5.4.48",
        "vlucas/valitron": "^1.4",
        "filp/whoops": "^2.18"
    },
    "scripts": {
        "test": "phpunit --testsuite unit",
        "test:all": "phpunit",
        "test:coverage": [
            "phpunit --coverage-text --coverage-clover tests/.coverage/clover.xml --coverage-html tests/.coverage/html",
            "@php tests/check_coverage.php"
        ]
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "config": {
        "platform": {
            "php": "8.0.30"
        }
    }
}
